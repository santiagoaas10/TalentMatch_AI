{
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": ["chrome-devtools", "context7", "postgres"],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-on-tools.sh\""
          }
        ]
      }
    ]
  }
}
